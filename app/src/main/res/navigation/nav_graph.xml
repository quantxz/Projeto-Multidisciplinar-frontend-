<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <!-- CHAT -->
    <fragment
        android:id="@+id/ChatFragment"
        android:name="com.example.projeto.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat">

        <argument
            android:name="nomeUsuario"
            app:argType="string"
            android:defaultValue="" />

    </fragment>

    <fragment
        android:id="@+id/MessagesFragment"
        android:name="com.example.projeto.MessagesFragment"
        android:label="Mensagens"
        tools:layout="@layout/fragment_messages">

        <action
            android:id="@+id/action_MessagesFragment_to_ChatFragment"
            app:destination="@id/ChatFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- LOGIN -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.projeto.FirstFragment"
        android:label="Login"
        tools:layout="@layout/fragment_first">

        <!-- Login → Cadastro -->
        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />

        <!-- Login → Perfil -->
        <action
            android:id="@+id/action_FirstFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

    </fragment>

    <!-- ========================= -->
    <!-- Produtos -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/ProductDetailFragment"
        android:name="com.example.projeto.ProductDetailFragment"
        android:label="Detalhes do produto">

        <argument
            android:name="produto"
            app:argType="com.example.projeto.data.Product" />

    </fragment>

    <!-- ========================= -->
    <!-- CADASTRO -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.projeto.SecondFragment"
        android:label="Cadastro"
        tools:layout="@layout/fragment_second">

        <!-- Cadastro → Login -->
        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

        <!-- Cadastro → Perfil -->
        <action
            android:id="@+id/action_SecondFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- PERFIL -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/ThirdFragment"
        android:name="com.example.projeto.ThirdFragment"
        android:label="Meu perfil"
        tools:layout="@layout/fragment_third">

        <!-- Perfil → Configurações -->
        <action
            android:id="@+id/action_ThirdFragment_to_NinthFragment"
            app:destination="@id/NinthFragment" />

        <!-- Perfil → Editar perfil -->
        <action
            android:id="@+id/action_ThirdFragment_to_TenthFragment"
            app:destination="@id/TenthFragment" />

        <!-- Perfil → Publicar material -->
        <action
            android:id="@+id/action_ThirdFragment_to_FourthFragment"
            app:destination="@id/FourthFragment" />

        <!-- Perfil → Buscar materiais -->
        <action
            android:id="@+id/action_ThirdFragment_to_FifthFragment"
            app:destination="@id/FifthFragment" />

        <!-- Perfil → Meus anúncios -->
        <action
            android:id="@+id/action_ThirdFragment_to_SixthFragment"
            app:destination="@id/SixthFragment" />

        <!-- Perfil → Meus matches -->
        <action
            android:id="@+id/action_ThirdFragment_to_SeventhFragment"
            app:destination="@id/SeventhFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- PUBLICAR MATERIAL -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/FourthFragment"
        android:name="com.example.projeto.FourthFragment"
        android:label="Publicar material"
        tools:layout="@layout/fragment_fourth">

        <!-- Publicar → Perfil -->
        <action
            android:id="@+id/action_FourthFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

        <!-- Publicar → Meus anúncios -->
        <action
            android:id="@+id/action_FourthFragment_to_SixthFragment"
            app:destination="@id/SixthFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- BUSCAR MATERIAIS -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/FifthFragment"
        android:name="com.example.projeto.FifthFragment"
        android:label="Buscar materiais"
        tools:layout="@layout/fragment_fifth">

        <!-- Buscar → Perfil -->
        <action
            android:id="@+id/action_FifthFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

        <!-- Buscar → Detalhes do produto -->
        <action
            android:id="@+id/action_FifthFragment_to_ProductDetailFragment"
            app:destination="@id/ProductDetailFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- MEUS ANÚNCIOS -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/SixthFragment"
        android:name="com.example.projeto.SixthFragment"
        android:label="Meus anúncios"
        tools:layout="@layout/fragment_sixth">

        <!-- Meus anúncios → Perfil -->
        <action
            android:id="@+id/action_SixthFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

        <!-- Meus anúncios → Publicar material -->
        <action
            android:id="@+id/action_SixthFragment_to_FourthFragment"
            app:destination="@id/FourthFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- MEUS MATCHES -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/SeventhFragment"
        android:name="com.example.projeto.SeventhFragment"
        android:label="Meus matches"
        tools:layout="@layout/fragment_seventh">

        <!-- Matches → Perfil -->
        <action
            android:id="@+id/action_SeventhFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

    </fragment>


    <!-- ========================= -->
    <!-- CONFIGURAÇÕES -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/NinthFragment"
        android:name="com.example.projeto.NinthFragment"
        android:label="Configurações"
        tools:layout="@layout/fragment_ninth">

        <!-- Configurações → Perfil -->
        <action
            android:id="@+id/action_NinthFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

        <!-- Configurações → Login -->
        <action
            android:id="@+id/action_NinthFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

        <!-- Configurações → Notificações -->
        <action
            android:id="@+id/action_NinthFragment_to_NotificationsFragment"
            app:destination="@id/NotificationsFragment" />

        <!-- Configurações → Privacidade -->
        <action
            android:id="@+id/action_NinthFragment_to_PrivacyFragment"
            app:destination="@id/PrivacyFragment" />

        <!-- Configurações → Ajuda -->
        <!-- Configurações → Ajuda -->
        <action
            android:id="@+id/action_NinthFragment_to_HelpFragment"
            app:destination="@id/HelpFragment" />

        <!-- Configurações → Termos de uso -->
        <action
            android:id="@+id/action_NinthFragment_to_TermsFragment"
            app:destination="@id/TermsFragment" />

    </fragment>
        <!-- ========================= -->
        <!-- NOTIFICAÇÕES -->
        <!-- ========================= -->


    <fragment
        android:id="@+id/NotificationsFragment"
        android:name="com.example.projeto.NotificationsFragment"
        android:label="Notificações"
        tools:layout="@layout/fragment_notifications" />


    <!-- ========================= -->
    <!-- PRIVACIDADE -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/PrivacyFragment"
        android:name="com.example.projeto.PrivacyFragment"
        android:label="Privacidade"
        tools:layout="@layout/fragment_privacy" />

    <!-- ========================= -->
    <!-- AJUDA -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/HelpFragment"
        android:name="com.example.projeto.HelpFragment"
        android:label="Ajuda"
        tools:layout="@layout/fragment_help" />


    <!-- ========================= -->
    <!-- TERMOS DE USO -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/TermsFragment"
        android:name="com.example.projeto.TermsFragment"
        android:label="Termos de uso"
        tools:layout="@layout/fragment_terms" />


    <!-- ========================= -->
    <!-- EDITAR PERFIL -->
    <!-- ========================= -->

    <fragment
        android:id="@+id/TenthFragment"
        android:name="com.example.projeto.TenthFragment"
        android:label="Editar perfil"
        tools:layout="@layout/fragment_tenth">

        <!-- Editar perfil → Perfil -->
        <action
            android:id="@+id/action_TenthFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />

    </fragment>

</navigation>