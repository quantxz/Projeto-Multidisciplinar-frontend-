<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="50dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp"
    android:background="#0D1117">

    <!-- BOTÃO VOLTAR -->

    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:background="@drawable/bg_button_transparent"
        android:contentDescription="Voltar"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="#FFFFFF" />

    <!-- TÍTULO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Meus materiais 📦"
        android:textColor="#2E7D32"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- MENSAGEM / ESTADO VAZIO -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="#0FFFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="5dp"
        app:strokeColor="#14FFFFFF"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvMeusMateriais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="Você ainda não possui materiais cadastrados."
            android:textColor="#A8B3AD"
            android:textSize="16sp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- LISTA -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#08FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:strokeColor="#14FFFFFF"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMateriais"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:scrollbars="none" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>