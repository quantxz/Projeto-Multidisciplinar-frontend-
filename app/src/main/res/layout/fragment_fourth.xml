<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- BOTÃO VOLTAR -->

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_button_transparent"
            android:contentDescription="Voltar"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />


        <!-- CONTEÚDO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="20dp"
            android:paddingEnd="8dp"
            android:paddingBottom="30dp">

            <!-- TÍTULO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="Publicar material ♻️"
                android:textColor="#2E7D32"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Informe os dados do material que você possui."
                android:textColor="#A8B3AD"
                android:textSize="16sp" />


            <!-- CARD DO FORMULÁRIO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:elevation="8dp"
                app:cardBackgroundColor="#0FFFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <!-- MATERIAL -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nome do material"
                        app:boxBackgroundColor="#0FFFFFFF"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#7F8A84">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtMaterial"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#7F8A84"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- CATEGORIA -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Categoria"
                        android:textColor="#A8B3AD"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spinnerCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_spinner"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />


                    <!-- FOTO -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Foto do material"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="#08FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#14FFFFFF"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/imgMaterial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Foto do material"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_camera"
                            android:tint="#7F8A84" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- SELECIONAR FOTO -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelecionarFoto"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:text="📷  SELECIONAR FOTO"
                        android:textColor="#2E7D32"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="#142E7D32"
                        app:cornerRadius="14dp"
                        app:strokeColor="#2E7D32"
                        app:strokeWidth="1dp" />


                    <!-- DESCRIÇÃO -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="Descrição"
                        app:boxBackgroundColor="#0FFFFFFF"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#7F8A84">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDescricaoMaterial"
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:padding="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#7F8A84"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- QUANTIDADE -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Quantidade"
                        app:boxBackgroundColor="#0FFFFFFF"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#7F8A84">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtQuantidade"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#7F8A84"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ESTADO -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Estado do material"
                        app:boxBackgroundColor="#0FFFFFFF"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#7F8A84">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtEstado"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#7F8A84"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- LOCALIZAÇÃO -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Localização aproximada"
                        app:boxBackgroundColor="#0FFFFFFF"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#7F8A84">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtLocalizacaoMaterial"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#7F8A84"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- PUBLICAR -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPublicar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="22dp"
                        android:text="PUBLICAR MATERIAL"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="14dp"
                        app:elevation="6dp"
                        app:rippleColor="#40FFFFFF" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </FrameLayout>

</ScrollView>