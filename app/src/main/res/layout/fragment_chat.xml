<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2">

    <!-- Cabeçalho -->
    <LinearLayout
        android:id="@+id/layoutCabecalhoChat"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Foto -->
        <ImageView
            android:id="@+id/imgUsuarioChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#E8F3EC"
            android:contentDescription="Foto do usuário"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_myplaces" />

        <!-- Nome e status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuário"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Conversa sobre materiais"
                android:textColor="#2E7D32"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♻️"
            android:textSize="24sp" />

    </LinearLayout>

    <!-- Área das mensagens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toTopOf="@id/layoutEnviarMensagem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCabecalhoChat" />

    <!-- Barra inferior -->
    <LinearLayout
        android:id="@+id/layoutEnviarMensagem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/edtMensagem"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="#E8F3EC"
            android:gravity="center_vertical"
            android:hint="Digite uma mensagem..."
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnEnviarMensagem"
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:layout_marginStart="9dp"
            android:backgroundTint="#2E7D32"
            android:contentDescription="Enviar mensagem"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>