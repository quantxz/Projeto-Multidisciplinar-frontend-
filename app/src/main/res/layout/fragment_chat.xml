<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:paddingTop="25dp">

    <!-- CABEÇALHO -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutCabecalhoChat"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="#0FFFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="#14FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="16dp">

            <!-- SETA VOLTAR -->

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_transparent"
                android:contentDescription="Voltar"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <!-- FOTO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#142E7D32"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#2E7D32"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgUsuarioChat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto do usuário"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="#A8B3AD" />

            </com.google.android.material.card.MaterialCardView>

            <!-- NOME E STATUS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNomeChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usuário"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Conversa sobre materiais"
                    android:textColor="#2E7D32"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♻"
                android:textColor="#2E7D32"
                android:textSize="24sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ÁREA DAS MENSAGENS -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="18dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutEnviarMensagem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCabecalhoChat" />


    <!-- BARRA INFERIOR -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutEnviarMensagem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#0FFFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="#14FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- ANEXAR -->

            <ImageButton
                android:id="@+id/btnAnexarArquivo"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_transparent"
                android:contentDescription="Anexar arquivo"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_add"
                android:tint="#2E7D32" />

            <!-- CAMPO DE MENSAGEM -->

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxBackgroundColor="#08FFFFFF"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#2E7D32"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMensagem"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:hint="Digite uma mensagem..."
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7F8A84"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ENVIAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarMensagem"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:layout_marginStart="9dp"
                android:contentDescription="Enviar mensagem"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="➤"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="14dp"
                app:elevation="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>