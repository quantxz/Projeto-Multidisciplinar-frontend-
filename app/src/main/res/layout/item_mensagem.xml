<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Foto da pessoa -->
        <ImageView
            android:id="@+id/imgFotoMensagem"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="#E8F3EC"
            android:contentDescription="Foto do usuário"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces" />

        <!-- Informações da conversa -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvNomeMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome da pessoa"
                android:textColor="#222222"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUltimaMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Última mensagem..."
                android:textColor="#666666"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Horário -->
        <TextView
            android:id="@+id/tvHorarioMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:text="10:42"
            android:textColor="#777777"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>