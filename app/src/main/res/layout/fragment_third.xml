<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- BOTÃO VOLTAR -->

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_button_transparent"
            android:contentDescription="Voltar"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />


        <!-- CONTEÚDO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="20dp"
            android:paddingEnd="8dp"
            android:paddingBottom="32dp">


            <!-- CABEÇALHO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="ReMatch ♻"
                android:textColor="#2E7D32"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaudacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="Olá! 👋"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Esse é o seu espaço no ReMatch."
                android:textColor="#A8B3AD"
                android:textSize="15sp" />


            <!-- CARD DO PERFIL -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:elevation="8dp"
                app:cardBackgroundColor="#0FFFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meu perfil"
                        android:textColor="#2E7D32"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNomeUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Seu nome"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLocalizacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="📍 Sua localização"
                        android:textColor="#A8B3AD"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Conte um pouco sobre você..."
                        android:textColor="#A8B3AD"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditarPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="Editar perfil"
                        android:textAllCaps="false"
                        android:textColor="#2E7D32"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="#142E7D32"
                        app:cornerRadius="14dp"
                        app:strokeColor="#2E7D32"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- SEÇÃO DE AÇÕES -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="O que você deseja fazer?"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Encontre materiais, publique anúncios e conecte-se com outras pessoas."
                android:textColor="#A8B3AD"
                android:textSize="14sp" />


            <!-- PUBLICAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarMaterial"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                android:text="Publicar material"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="14dp"
                app:elevation="5dp"
                app:rippleColor="#40FFFFFF" />


            <!-- BUSCAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscarMateriais"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:text="Buscar materiais"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#0FFFFFFF"
                app:cornerRadius="14dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp" />


            <!-- MEUS ANÚNCIOS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMeusMateriais"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:text="Meus anúncios"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#0FFFFFFF"
                app:cornerRadius="14dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp" />


            <!-- CONVERSAS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMatches"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:text="Minhas conversas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#0FFFFFFF"
                app:cornerRadius="14dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp" />


            <!-- CONFIGURAÇÕES -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfiguracoes"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="Configurações"
                android:textAllCaps="false"
                android:textColor="#A8B3AD"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#08FFFFFF"
                app:cornerRadius="14dp"
                app:strokeColor="#14FFFFFF"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </FrameLayout>

</ScrollView>