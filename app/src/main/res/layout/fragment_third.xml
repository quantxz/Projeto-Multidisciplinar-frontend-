<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true"
    android:paddingTop="25dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- BOTÃO VOLTAR -->

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />


        <!-- CONTEÚDO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- CABEÇALHO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="ReMatch ♻"
                android:textColor="#245B32"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaudacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Olá! 👋"
                android:textColor="#222222"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Esse é o seu espaço no ReMatch."
                android:textColor="#718078"
                android:textSize="15sp" />


            <!-- CARD DO PERFIL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meu perfil"
                    android:textColor="#245B32"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNomeUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Seu nome"
                    android:textColor="#222222"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLocalizacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="📍 Sua localização"
                    android:textColor="#718078"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Conte um pouco sobre você..."
                    android:textColor="#59635D"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#DDEBDD"
                    android:text="Editar perfil"
                    android:textAllCaps="false"
                    android:textColor="#2E7D32"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- SEÇÃO DE AÇÕES -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="O que você deseja fazer?"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Encontre materiais, publique anúncios e conecte-se com outras pessoas."
                android:textColor="#718078"
                android:textSize="14sp" />


            <!-- PUBLICAR -->

            <Button
                android:id="@+id/btnPublicarMaterial"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#2E7D32"
                android:text="Publicar material"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- BUSCAR -->

            <Button
                android:id="@+id/btnBuscarMateriais"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Buscar materiais"
                android:textAllCaps="false"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- MEUS ANÚNCIOS -->

            <Button
                android:id="@+id/btnMeusMateriais"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Meus anúncios"
                android:textAllCaps="false"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- CONVERSAS -->

            <Button
                android:id="@+id/btnMatches"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Minhas conversas"
                android:textAllCaps="false"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- CONFIGURAÇÕES -->

            <Button
                android:id="@+id/btnConfiguracoes"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#E2E9E3"
                android:text="Configurações"
                android:textAllCaps="false"
                android:textColor="#496050"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</ScrollView>